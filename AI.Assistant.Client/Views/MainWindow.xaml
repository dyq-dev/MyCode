<Window x:Class="AI.Assistant.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AI.Assistant.Client.Controls"
        xmlns:views="clr-namespace:AI.Assistant.Client.Views"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="AI Assistant"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource PrimaryFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================
             LEFT SIDEBAR
             ============================================ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Padding="16,16,16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AccentBrush}"
                                CornerRadius="8"
                                Width="32" Height="32"
                                Margin="0,0,10,0">
                            <Path Data="M6,18 L10,18 L10,22 L6,22 Z M14,6 L14,10 L18,10 L18,6 Z M2,12 C2,6.48 6.48,2 12,2 C17.52,2 22,6.48 22,12 C22,17.52 17.52,22 12,22 C6.48,22 2,17.52 2,12 Z"
                                  Fill="White"
                                  Stretch="Uniform"
                                  Width="18" Height="18" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AI Assistant"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Powered by LLM"
                                       FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- New Chat Button -->
                <Border Grid.Row="1" Padding="12,0,12,8">
                    <Button Command="{Binding NewConversationCommand}"
                            Style="{StaticResource NewChatButton}"
                            HorizontalAlignment="Stretch"
                            Padding="0">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="+"
                                       FontSize="16"
                                       FontWeight="Light"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="新建对话"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Border>

                <!-- Knowledge Playground -->
                <Border Grid.Row="2" Padding="8,0,8,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPlayground}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaygroundMode}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Command="{Binding TogglePlaygroundCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="0"
                            Style="{StaticResource ConversationItemButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="6"
                                    Width="22" Height="22"
                                    VerticalAlignment="Center">
                                <Path Data="M15,15 L21,21 M10,17 A7,7 0 1,1 10,3 A7,7 0 0,1 10,17 Z"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="12" Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Knowledge Playground"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                        </Grid>
                    </Button>
                </Border>

                <!-- Knowledge Sources -->
                <Border Grid.Row="3" Padding="8,0,8,4">
                    <StackPanel>
                        <Grid Margin="8,2,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="知识源"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="+"
                                    FontSize="14"
                                    FontWeight="Light"
                                    Width="22" Height="22"
                                    ToolTip="添加文档"
                                    Command="{Binding AddDocumentCommand}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayIcon}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,6,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2"
                                                CornerRadius="4"
                                                Padding="5,1"
                                                Background="{StaticResource SurfaceBrush}">
                                            <TextBlock Text="{Binding IndexStatus, FallbackValue='未索引'}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="🔄 重新索引"
                                                          Command="{Binding DataContext.ReindexSourceCommand, Source={x:Reference RootWindow}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="🗑️ 删除"
                                                          Command="{Binding DataContext.DeleteSourceCommand, Source={x:Reference RootWindow}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- RAG Toggle -->
                <Border Grid.Row="4" Padding="12,2,12,6"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="4,6,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RAG 搜索"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="关闭后仅使用 AI 自身知识"
                                       FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding IsRagEnabled}"
                                      Width="40" Height="22"
                                      VerticalAlignment="Center"
                                      BorderThickness="0">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg"
                                                        Width="40" Height="22"
                                                        CornerRadius="11"
                                                        Background="#CBD5E1"
                                                        BorderThickness="0"
                                                        Cursor="Hand">
                                                    <Border x:Name="Knob"
                                                            Width="18" Height="18"
                                                            CornerRadius="9"
                                                            Background="White"
                                                            HorizontalAlignment="Left"
                                                            Margin="2,0,0,0"
                                                            Effect="{StaticResource SmallShadow}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                                        <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                </Border>

                <!-- Conversation List -->
                <Border Grid.Row="5" Padding="8,0,8,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Conversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Margin="0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="重命名"
                                                          Command="{Binding DataContext.RenameConversationCommand, Source={x:Reference RootWindow}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Style="{StaticResource ConversationItemButton}"
                                                    Grid.ColumnSpan="3"
                                                    Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{StaticResource SurfaceBrush}"
                                                            CornerRadius="6"
                                                            Width="22" Height="22"
                                                            VerticalAlignment="Center">
                                                        <Path Data="M3,3 L19,3 A2,2 0 0,1 21,5 L21,15 A2,2 0 0,1 19,17 L10,17 L5,21 L5,17 L3,17 A2,2 0 0,1 1,15 L1,5 A2,2 0 0,1 3,3 Z"
                                                              Fill="{StaticResource TextTertiaryBrush}"
                                                              Stretch="Uniform"
                                                              Width="12" Height="12"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0" />
                                                </Grid>
                                            </Button>

                                            <!-- Delete button -->
                                            <Button Grid.Column="2"
                                                    Content="&#x2715;"
                                                    ToolTip="删除对话"
                                                    Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DeleteButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="6"
                        Padding="12,8"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="v1.0.0"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Resize Handle -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      Cursor="SizeWE" />

        <!-- ============================================
             RIGHT - Content Area (Chat / Playground)
             ============================================ -->
        <Grid Grid.Column="2">

            <!-- ========== Chat Panel ========== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPlaygroundMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Bar -->
            <Border Grid.Row="0"
                    Padding="20,14,20,14"
                    Background="{StaticResource WhiteBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentLightBrush}"
                                CornerRadius="8"
                                Width="32" Height="32"
                                Margin="0,0,12,0">
                            <Path Data="M3,3 L19,3 A2,2 0 0,1 21,5 L21,15 A2,2 0 0,1 19,17 L10,17 L5,21 L5,17 L3,17 A2,2 0 0,1 1,15 L1,5 A2,2 0 0,1 3,3 Z"
                                  Fill="{StaticResource AccentBrush}"
                                  Stretch="Uniform"
                                  Width="16" Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding CurrentConversation.Title, FallbackValue='新对话'}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Status -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,6,0" />
                        <TextBlock Text="就绪"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================
                 Messages Area
                 ============================================ -->
            <Border Grid.Row="1" Background="{StaticResource WhiteBrush}">
                <ScrollViewer x:Name="MessagesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0">
                    <ItemsControl ItemsSource="{Binding CurrentConversation.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- System message -->
                                        <Border Grid.ColumnSpan="2"
                                                HorizontalAlignment="Center"
                                                MaxWidth="600"
                                                Padding="14,10"
                                                CornerRadius="8"
                                                Background="#FEF3C7"
                                                BorderBrush="#FDE68A"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Content}"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"
                                                       Foreground="#92400E"
                                                       TextAlignment="Center" />
                                        </Border>

                                        <!-- Assistant message -->
                                        <Border Grid.Column="0"
                                                MaxWidth="700"
                                                Padding="16,12"
                                                Margin="20,0,60,0"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource AssistantBubbleBrush}"
                                                BorderBrush="{StaticResource AccentLightBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4,16,16,16"
                                                Effect="{StaticResource SmallShadow}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{StaticResource AccentBrush}"
                                                            CornerRadius="6"
                                                            Width="24" Height="24"
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="AI"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="助手"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayTime}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0" />

                                                    <!-- RAG badge -->
                                                    <Border CornerRadius="4"
                                                            Padding="4,1,4,2"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="#DBEAFE"
                                                            BorderBrush="#93C5FD"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasRagContext}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="RAG"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="#1D4ED8" />
                                                    </Border>
                                                </StackPanel>
                                                <controls:MarkdownView Grid.Row="2"
                                                                       Markdown="{Binding Content}"
                                                                       IsStreaming="{Binding IsStreaming}" />

                                                <!-- RAG info (collapsible) -->
                                                <Border Grid.Row="3" Margin="0,8,0,0"
                                                        CornerRadius="8"
                                                        Background="#F8FAFC"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="1"
                                                        Padding="10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasRagContext}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="RAG 上下文已注入"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#475569" />
                                                            <TextBlock Text="{Binding RagSummary, StringFormat='  ·  {0}'}"
                                                                       FontSize="11"
                                                                       Foreground="#64748B"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Border Grid.Row="1" Margin="0,6,0,0"
                                                                CornerRadius="6"
                                                                Background="#1E293B"
                                                                Padding="10"
                                                                MaxHeight="240">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                <TextBlock Text="{Binding RagContextText}"
                                                                           FontFamily="Cascadia Code, Consolas, monospace"
                                                                           FontSize="11"
                                                                           Foreground="#E2E8F0"
                                                                           TextWrapping="Wrap" />
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- User message -->
                                        <Border Grid.Column="1"
                                                MaxWidth="600"
                                                Padding="14,10"
                                                Margin="60,0,20,0"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource UserBubbleBrush}"
                                                CornerRadius="16,16,4,16">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Content}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       LineHeight="22"
                                                       Foreground="{StaticResource TextOnDarkBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ============================================
                 Input Area
                 ============================================ -->
            <Border Grid.Row="2"
                    Padding="20,12,20,20"
                    Background="{StaticResource WhiteBrush}">
                <Grid HorizontalAlignment="Center" Width="760">
                    <Border CornerRadius="24"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="{StaticResource WhiteBrush}"
                            Padding="6"
                            Effect="{StaticResource SmallShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="12,0,4,0">
                                <TextBlock Text=" 输入消息... (Ctrl+Enter 发送)"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="15"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Margin="0,8,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer MaxHeight="200"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBox x:Name="InputTextBox"
                                             Style="{StaticResource InputTextBox}"
                                             Text="{Binding CurrentConversation.InputText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Center">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter"
                                                        Modifiers="Control"
                                                        Command="{Binding CurrentConversation.SendMessageCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </ScrollViewer>
                            </Grid>

                            <Button Grid.Column="1"
                                    Command="{Binding CurrentConversation.SendMessageCommand}"
                                    Style="{StaticResource SendButton}"
                                    Margin="4,0,2,0"
                                    VerticalAlignment="Bottom"
                                    ToolTip="发送消息 (Ctrl+Enter)" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>
            <!-- ========== End Chat Panel ========== -->

            <!-- ========== Playground Panel ========== -->
            <views:KnowledgePlaygroundView>
                <views:KnowledgePlaygroundView.Style>
                    <Style TargetType="views:KnowledgePlaygroundView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPlaygroundMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:KnowledgePlaygroundView.Style>
            </views:KnowledgePlaygroundView>
        </Grid>
    </Grid>
</Window>
